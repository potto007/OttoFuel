<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="environment.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AutomaticFuel</AssemblyName>
    <RootNamespace>AutomaticFuel</RootNamespace>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- The publicizer opens the private game members that the Harmony patches read. -->
    <Reference Include="assembly_valheim" HintPath="$(CorlibPath)/assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(CorlibPath)/assembly_utils.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_guiutils" HintPath="$(CorlibPath)/assembly_guiutils.dll" Private="false" Publicize="true" />

    <Reference Include="0Harmony" HintPath="$(BepInExPath)/core/0Harmony.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExPath)/core/BepInEx.dll" Private="false" />
    <Reference Include="ServerSync" HintPath="Libs/ServerSync.dll" Private="true" />

    <Reference Include="UnityEngine" HintPath="$(CorlibPath)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(CorlibPath)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(CorlibPath)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(CorlibPath)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(CorlibPath)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(CorlibPath)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(CorlibPath)/UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.43" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="environment.props" />
    <None Include="ILRepack.targets" />
    <None Include="README.md" />
    <None Include="Thunderstore/manifest.json" />
    <None Include="Thunderstore/icon.png" />
    <None Include="Thunderstore/README.md" />
  </ItemGroup>

  <!-- Drop the built plugin into the BepInEx profile named by environment.props. -->
  <Target Name="CopyOutputDLL" AfterTargets="ILRepacker" Condition="'$(CopyOutputDLLPath)' != '' AND Exists('$(CopyOutputDLLPath)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CopyOutputDLLPath)" OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
